# Groq API Configuration for Prescription OCR & Structured Digitization (Server-side only)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# HiveMQ Cloud MQTT Configuration (WebSocket over TLS/WSS)
VITE_HIVEMQ_WS_URL="wss://YOUR_BROKER.s1.eu.hivemq.cloud:8884/mqtt"
VITE_HIVEMQ_USERNAME="your_hivemq_username"
VITE_HIVEMQ_PASSWORD="your_hivemq_password"
